# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres. Vercel → your project → Storage → Create → Neon sets this
# for you in Vercel; copy the same value here for local development.
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Signs session cookies. Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Where the app runs. Locally http://localhost:3000; in production your
# Vercel domain, e.g. https://pulse.vercel.app
BETTER_AUTH_URL="http://localhost:3000"

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (Web application). Authorised redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-vercel-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
